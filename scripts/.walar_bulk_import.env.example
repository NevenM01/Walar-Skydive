WALAR_IMPORT_DIR=C:\Users\ime\Desktop\walar_imports
WALAR_SUPABASE_URL=https://xxxx.supabase.co
WALAR_SERVICE_ROLE_KEY=eyJ...
# Copy to scripts/.walar_bulk_import.env (gitignored) or set these in your shell.
# NEVER commit Supabase keys.
WALAR_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase "publishable" (public) key. This is still a key — keep it out of git.
WALAR_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Admin user access token (JWT). Get it by signing into the app as an admin user.
WALAR_SUPABASE_ACCESS_TOKEN=your-admin-access-token

# Folder containing walar_imports xlsx files. May also be passed as --import-dir CLI flag.
WALAR_IMPORT_DIR=C:/path/to/walar_imports

